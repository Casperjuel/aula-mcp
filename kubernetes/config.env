# Edit before applying. Multi-parent mode: every request needs a token from
# this issuer, and each parent gets their own Aula login.
AULA_MCP_MULTI_PARENT=1
AULA_MCP_OIDC_ISSUER=https://keycloak.example.com/realms/kagent
AULA_MCP_OIDC_AUDIENCE=aula-mcp
# kagent's oauth2-proxy forwards ID tokens, not access tokens.
AULA_MCP_OIDC_ACCEPT_ID_TOKEN=1
